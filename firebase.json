{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "DEPLOYMENT-ON-ANDROID.md",
      ".firebaserc",
      ".github/**",
      "node_modules/**",
      "**/.*"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}